# ---------------------------------------------------------------------------
# SARAD — environment template. Copy to .env / apps/*/.env and fill in.
# NEVER commit a filled .env
# ---------------------------------------------------------------------------

# --- Supabase (client-side, safe to expose: publishable/anon key only) ------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# --- Supabase (server-side ONLY: edge functions / admin scripts) -----------
# Service role / secret key bypasses RLS. Must never ship in the mobile app.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# --- Expo mobile app -------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_APP_SCHEME=sarad
EXPO_PUBLIC_DEFAULT_LANG=ar
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# --- Admin dashboard (Vite) ------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_or_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxx
PAYPAL_CLIENT_ID=xxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxx
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxx

# --- Email / OTP -----------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=no-reply@example.com

# --- Push ------------------------------------------------------------------
EXPO_ACCESS_TOKEN=xxxxxxxxxxxxx

# --- Google sign-in (Expo / native) ---------------------------------------
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
